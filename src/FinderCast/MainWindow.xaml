<Window
    x:Class="FinderCast.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FinderCast"
    xmlns:controls="using:FinderCast.Controls"
    Title="FinderCast">

    <!--
        Tarjeta de búsqueda del lanzador, sobre Acrylic. Los resultados van en su propia tarjeta
        (ResultsWindow), justo debajo.
    -->
    <Grid x:Name="Root" KeyDown="OnRootKeyDown">
        <!-- Búsqueda -->
        <Grid x:Name="SearchBar" Padding="20,0,14,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{ThemeResource FcSecondaryBrush}" VerticalAlignment="Center" />
            <TextBox x:Name="SearchBox" Grid.Column="1"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource FcTextFont}" FontSize="15"
                     Padding="0,6,0,3"
                     BorderThickness="0"
                     IsSpellCheckEnabled="False"
                     PreviewKeyDown="OnSearchKeyDown"
                     TextChanged="OnSearchChanged">
                <!-- Caja sin fondo, borde ni subrayado al enfocarla: solo el texto sobre el cristal. -->
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>
            <!-- Engranaje: abre los ajustes. Sin foco de teclado, para no sacarlo de la búsqueda. -->
            <Button x:Name="SettingsButton" Grid.Column="2"
                    Width="34" Height="34" Padding="0" CornerRadius="6"
                    VerticalAlignment="Center" IsTabStop="False"
                    BorderThickness="0" Background="Transparent"
                    Click="OnSettingsClick">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                </Button.Resources>
                <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource FcSecondaryBrush}" />
            </Button>
        </Grid>

    </Grid>
</Window>
