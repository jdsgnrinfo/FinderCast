<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Colores del sistema de diseño compartido con SwiftLook y ShutterGrid: paleta neutra de
        shadcn/ui y menús de Windows 11, para el tema claro y el oscuro.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="FcTextBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="FcSecondaryBrush" Color="#5F5F5F" />
            <!-- Sobre Mica y Acrylic la línea es translúcida para que tome el tinte del material. -->
            <SolidColorBrush x:Key="FcDividerBrush" Color="#10000000" />
            <Color x:Key="FcHoverColor">#0D000000</Color>
            <SolidColorBrush x:Key="FcHoverBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="FcKeyFillBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FcKeyBorderBrush" Color="#E9E9E9" />
            <SolidColorBrush x:Key="FcOnKeyBrush" Color="#5C5C5C" />
            <SolidColorBrush x:Key="FcKeyBorderLiftBrush" Color="#C4C4C4" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="FcTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FcSecondaryBrush" Color="#B0B0B0" />
            <SolidColorBrush x:Key="FcDividerBrush" Color="#14FFFFFF" />
            <Color x:Key="FcHoverColor">#10FFFFFF</Color>
            <SolidColorBrush x:Key="FcHoverBrush" Color="#10FFFFFF" />
            <SolidColorBrush x:Key="FcKeyFillBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="FcKeyBorderBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="FcOnKeyBrush" Color="#B5B5B5" />
            <SolidColorBrush x:Key="FcKeyBorderLiftBrush" Color="#30FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Tipografía (sistema de diseño, sección 3): tamaños en DIP, 1 pt = 4/3 px. -->
    <FontFamily x:Key="FcDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FcTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FcSmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
    <!-- Título 13 pt, cuerpo 9,5 pt, pie 7 pt. -->
    <x:Double x:Key="FcTitleSize">17.333</x:Double>
    <x:Double x:Key="FcBodySize">12.667</x:Double>
    <x:Double x:Key="FcCaptionSize">9.333</x:Double>

    <!-- Etiqueta de una fila de ajustes. -->
    <Style x:Key="FcRowLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FcTextFont}" />
        <Setter Property="FontSize" Value="{StaticResource FcBodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource FcTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Texto de una tecla suelta (Ctrl, Alt, ↵…): 9 pt Medium, como en ShutterGrid. -->
    <Style x:Key="FcKeyCapTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FcTextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource FcOnKeyBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
