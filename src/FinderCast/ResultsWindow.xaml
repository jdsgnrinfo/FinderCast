<Window
    x:Class="FinderCast.ResultsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FinderCast"
    xmlns:controls="using:FinderCast.Controls"
    Title="FinderCast">

    <!--
        Tarjeta de resultados, bajo la de búsqueda: lista de apps o cuadrícula de emojis. Nunca recibe
        el foco: el teclado sigue en la búsqueda y el ratón elige y abre.
    -->
    <Grid>
        <ListView x:Name="Results"
                  Padding="0,12"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  AllowFocusOnInteraction="False"
                  IsTabStop="False"
                  RightTapped="OnRightTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Margin" Value="12,1" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="12,0,16,0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="AllowFocusOnInteraction" Value="False" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ResultItem">
                    <Grid Height="44" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="22" Height="22" />
                        <!-- Emojis y símbolos: el propio carácter, del tamaño del icono. -->
                        <TextBlock Text="{x:Bind Glyph}" Width="22"
                                   FontFamily="Segoe UI Emoji" FontSize="17" TextAlignment="Center"
                                   Foreground="{ThemeResource FcTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                   FontFamily="{StaticResource FcTextFont}" FontSize="14"
                                   Foreground="{ThemeResource FcTextBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind KindLabel}"
                                   FontFamily="{StaticResource FcTextFont}" FontSize="12"
                                   Foreground="{ThemeResource FcSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Detail, Mode=OneWay}"
                                   FontFamily="{StaticResource FcTextFont}" FontSize="13"
                                   Foreground="{ThemeResource FcSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
            Emojis y símbolos (":nombre"): cuadrícula de casillas de 64 × 62, nueve por fila y
            cuatro filas a la vista.
        -->
        <GridView x:Name="EmojiGrid"
                  Padding="12,12"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  AllowFocusOnInteraction="False"
                  IsTabStop="False"
                  Visibility="Collapsed">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="64" ItemHeight="62" Loaded="OnEmojiPanelLoaded" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="AllowFocusOnInteraction" Value="False" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:ResultItem">
                    <TextBlock Text="{x:Bind Glyph}"
                               FontFamily="Segoe UI Emoji" FontSize="28"
                               Foreground="{ThemeResource FcTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               ToolTipService.ToolTip="{x:Bind Name}" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock x:Name="EmptyText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="{StaticResource FcTextFont}" FontSize="{StaticResource FcBodySize}"
                   Foreground="{ThemeResource FcSecondaryBrush}"
                   Visibility="Collapsed" />
    </Grid>
</Window>
