<?xml version="1.0" encoding="utf-8"?>
<!--
  La versión portable: FinderCast.exe con .NET y el Windows App SDK dentro de la carpeta, para
  que funcione en cualquier Windows 10 (2004) u 11 de 64 bits sin instalar nada.
    dotnet publish src/FinderCast -p:PublishProfile=Portable
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Números de línea en los errores, sin un .pdb aparte. -->
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\FinderCast-$(Version)-portable\</PublishDir>
  </PropertyGroup>
</Project>
