<?xml version="1.0" encoding="utf-8"?>
<!--
  La versión portable: un único FinderCast.exe comprimido con .NET, el Windows App SDK y los
  recursos dentro, para que funcione en cualquier Windows 10 (2004) u 11 de 64 bits sin instalar
  nada. La primera vez que se abre extrae sus partes nativas a la carpeta temporal del usuario.
    dotnet publish src/FinderCast -p:PublishProfile=Portable
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Un solo .exe: también las DLL nativas de WinUI, los .pri y los iconos, que se extraen al abrirlo. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Números de línea en los errores, sin un .pdb aparte. -->
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\FinderCast-$(Version)-portable\</PublishDir>
  </PropertyGroup>
</Project>
